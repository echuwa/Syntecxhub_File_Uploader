{
  "name": "syntecxhub_file_uploader",
  "version": "1.0.0",
  "description": "Production-grade File Uploader API with Multer & MongoDB GridFS, featuring an interactive React 19 dashboard",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n \"API,CLIENT\" -c \"cyan.bold,magenta.bold\" \"node server/server.js\" \"vite\"",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.js",
    "test": "node test/api.test.js"
  },
  "keywords": [
    "syntecxhub",
    "internship",
    "file-uploader",
    "multer",
    "gridfs",
    "mongodb",
    "express",
    "react19"
  ],
  "author": "SyntecxHub Intern",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.4",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}
