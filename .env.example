# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local authenticated MongoDB:
MONGO_URI=mongodb://<username>:<password>@127.0.0.1:27017/syntecxhub_file_uploader?authSource=admin
# Or for unauthenticated MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/syntecxhub_file_uploader

DB_NAME=syntecxhub_file_uploader
GRIDFS_BUCKET=uploads

# Upload Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_COUNT=10
